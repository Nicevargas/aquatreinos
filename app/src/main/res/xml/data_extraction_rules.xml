<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup na nuvem e transferência entre aparelhos (Android 12+).
   A sessão de login (tokens do Supabase) fica fora dos dois: no aparelho
   novo, a pessoa entra de novo com e-mail e senha.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="aquagenda_sessao.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="aquagenda_sessao.xml" />
    </device-transfer>
</data-extraction-rules>
