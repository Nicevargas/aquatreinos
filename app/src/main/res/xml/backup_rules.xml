<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup automático (Android 11 e anteriores).
   A sessão de login (tokens do Supabase) não sai do aparelho: restaurada em
   outro celular, daria acesso à conta sem senha.
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <exclude domain="sharedpref" path="aquagenda_sessao.xml" />
    <!-- Data do PAR-Q: dado de saúde; no aparelho novo o app confere no Supabase. -->
    <exclude domain="sharedpref" path="parq_prontidao.xml" />
</full-backup-content>
