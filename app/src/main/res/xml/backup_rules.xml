<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup automático (Android 11 e anteriores).
   A sessão de login (tokens do Supabase) não sai do aparelho: restaurada em
   outro celular, daria acesso à conta sem senha.
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <exclude domain="sharedpref" path="aquagenda_sessao.xml" />
</full-backup-content>
