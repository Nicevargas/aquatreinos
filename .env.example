# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# SUPABASE CONFIGURATION:
# Configure your Supabase project URL and anon public key.
# Users configure this via the Secrets panel in AI Studio or .env file.
SUPABASE_URL=https://placeholder.supabase.co
SUPABASE_ANON_KEY=placeholder-supabase-anon-key
